<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Shared fallback for every shipped binary's own <Version> (h9k and h9kd alike), so a
         local build that derives no git-describe stamp reports the checked-in placeholder
         instead of the SDK's own meaningless default of 1.0.0 (cycle 1 review finding: h9kd
         carried no <Version> of its own and silently diverged from h9k's 0.1.0). -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- GHSA-rfx3-98h7-v3xp (Marten, task 29b0ca1a removes this once the Marten 9 upgrade lands):
         the three LINQ sinks were fixed in Marten 8.37.4, already covered by the 8.38.1 pin above;
         the two tenant DDL sinks do not exist on the 8.0 branch at all, and hall9k has no tenancy
         and serializes with System.Text.Json, so no reachable sink remains on this branch. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rfx3-98h7-v3xp" />
  </ItemGroup>
</Project>
