<Project>

  <!-- A Development settings file is a dev-loop concern only (Aspire/the local worktree set
       DOTNET_ENVIRONMENT=Development); an installed binary always runs Production, so nothing
       reads it there, and its only fate otherwise is riding into every install unnoticed until
       someone puts a dev connection string or a chatty flag in it (origin: found sitting in
       ~/.hall9k/bin beside appsettings.json, 2026-08-24). This lives here rather than in each
       project file so it binds regardless of the item's type (Content under the Worker/Web SDKs,
       None under the base SDK) or where in the project body it was declared: Directory.Build.targets
       imports after the whole project body and the SDK's own default-items resolution, so an
       Update here reaches an item added anywhere, including one declared after this file would
       have been read if it were imported at the top (found in review: a project-local Content
       Update in Hall9k.Cli.csproj was inert for exactly this reason, since the base SDK declares
       no default Content item for *.json to update in the first place). Only
       CopyToPublishDirectory is set to Never — CopyToOutputDirectory stays at its default so the
       file still lands in bin/ for the dev loop that is the only place it is ever meant to be
       read; setting it to Never too (an earlier version of this rule did) silently broke that
       loop instead. The glob is recursive (**) so a settings file nested under a subfolder is
       still caught. The lowercase second rule matches on case-sensitive filesystems, where
       MSBuild's Update comparison does not fold case the way Windows does — but it only adds a
       second literal casing, not full case-insensitivity, so *.DEVELOPMENT.* or any other mixed
       casing still slips past this file on such a filesystem. InstallCommand.IsDevelopmentSettingsFile
       and the release workflow's `find -iname` both match case-insensitively and so catch a wider
       set than this glob does; InstallCommand.RemoveDevelopmentSettingsFiles running over staging
       is what actually closes that gap for an installed machine, and this file's job is only to
       keep the common case out of the publish output in the first place. -->
  <ItemGroup>
    <Content Update="**\*.Development.*" CopyToPublishDirectory="Never" />
    <Content Update="**\*.development.*" CopyToPublishDirectory="Never" />
    <None Update="**\*.Development.*" CopyToPublishDirectory="Never" />
    <None Update="**\*.development.*" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
