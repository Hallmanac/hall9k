<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>h9k</AssemblyName>
    <RootNamespace>Hall9k.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>h9k</ToolCommandName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="NJsonSchema" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CLI carries no settings file today, but the acceptance criteria calls for the
         exclusion to live in the project files of both h9k and h9kd, so a Development
         settings file added here later is excluded from day one rather than depending on
         whoever adds it to remember the guard (mirrors Hall9k.Daemon.csproj). The lowercase
         second rule matches on case-sensitive filesystems, where MSBuild's Update comparison
         does not fold case the way Windows does, so a mistakenly-lowercased
         *.development.* file is still caught. -->
    <Content Update="*.Development.*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="*.development.*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Hall9k.Domain.Infrastructure.Extensions" />
    <InternalsVisibleTo Include="Hall9k.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hall9k.Domain\Hall9k.Domain.csproj" />
    <ProjectReference Include="..\Hall9k.Connectors\Hall9k.Connectors.csproj" />
  </ItemGroup>

</Project>
