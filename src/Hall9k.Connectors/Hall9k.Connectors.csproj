<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Using Include="Hall9k.Domain.Infrastructure.Extensions" />
    <!-- JasperFx.Events 1.36 adds its own StreamState, ambiguous with Marten.Events.StreamState -->
    <Using Include="Marten.Events.StreamState" Alias="StreamState" />
  </ItemGroup>

  <ItemGroup>
    <!-- Worktree/prompt services (shared with the CLI, so they cannot pull in Microsoft.Extensions.Hosting) need ILogger<T> -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hall9k.Domain\Hall9k.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hall9k.Tests" />
  </ItemGroup>

</Project>
